# Local dev defaults to sqlite:///./dev.db — set this to point at Supabase Postgres in prod.
DATABASE_URL=

# S3-compatible storage — MinIO locally, Cloudflare R2 in prod (same client code, different endpoint).
# In prod against R2, set S3_REGION=auto (R2's required magic value) alongside your account's R2 endpoint.
S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=avseparate-dev
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=us-east-1

# Filled in starting M2 (separation pipeline).
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

# Filled in when auth lands.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Comma-separated origins allowed to call this API. Defaults to the standard
# Vite dev port; add your Cloudflare Pages domain here in prod.
CORS_ALLOW_ORIGINS=http://localhost:5173
