# Local dev defaults to sqlite:///./dev.db — set this to point at Supabase Postgres in prod.
DATABASE_URL=

# S3-compatible storage — MinIO locally, Cloudflare R2 in prod (same client code, different endpoint).
# In prod against R2, set S3_REGION=auto (R2's required magic value) alongside your account's R2 endpoint.
S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=avseparate-dev
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=us-east-1

# M2 (separation pipeline). MODAL_TOKEN_ID/SECRET authenticate this backend
# process as a Modal client (from `modal token new`, or Modal dashboard).
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
MODAL_APP_NAME=avseparate

# Shared secret the Modal function uses to call back into /internal/jobs/*.
# Generate with `openssl rand -hex 32`. Must also be set as INTERNAL_API_SECRET
# in the "avseparate-secrets" Modal secret (along with BACKEND_URL and the
# same S3_* values above) — see modal_app.py's module docstring.
INTERNAL_API_SECRET=

# A job stuck "processing" longer than this (seconds) is marked failed on the
# next read — safety net for Modal container timeouts/crashes that never
# reach the /internal/jobs/*/fail callback. Defaults to 1100 (Modal's own
# function timeout in modal_app.py is 900, covering separation + chords).
JOB_TIMEOUT_SECONDS=1100

# How many days a completed song's stems can go unplayed (last GET of
# /songs/{id}/stems, falling back to upload date if never played) before
# they're deleted from storage. Swept lazily on every GET /songs.
STEM_RETENTION_DAYS=1

# Filled in when auth lands.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Comma-separated origins allowed to call this API. Defaults to the standard
# Vite dev port; add your Cloudflare Pages domain here in prod.
CORS_ALLOW_ORIGINS=http://localhost:5173
